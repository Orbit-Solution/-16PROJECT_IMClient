# Application
APP_NAME=Divigamana
APP_URL=https://divigamana.lk
APP_ENV=development
APP_TIMEZONE=Asia/Colombo

# Supabase public (safe for browser with RLS enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / Edge Functions only — never expose in frontend bundles
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Alibaba Cloud Model Studio
ALIBABA_CLOUD_API_KEY=
ALIBABA_CLOUD_MODEL=
ALIBABA_CLOUD_BASE_URL=
ALIBABA_CLOUD_WORKSPACE_ID=
ALIBABA_CLOUD_REGION=
ALIBABA_AI_MAX_TOKENS=1200
ALIBABA_AI_TEMPERATURE=0.7

# Ideamart — leave blank until provider credentials and exact endpoints are supplied
IDEAMART_API_BASE_URL=
IDEAMART_APP_ID=
IDEAMART_APP_PASSWORD=
IDEAMART_SERVICE_ID=
IDEAMART_OTP_ENDPOINT=
IDEAMART_VERIFY_ENDPOINT=
IDEAMART_SUBSCRIBE_ENDPOINT=
IDEAMART_UNSUBSCRIBE_ENDPOINT=
IDEAMART_STATUS_ENDPOINT=
IDEAMART_WEBHOOK_SECRET=

# Demo integrations — only permitted in development/test
OTP_PROVIDER=mock
SUBSCRIPTION_PROVIDER=mock
AI_PROVIDER=mock
DEMO_OTP_ENABLED=true
DEMO_OTP_CODE=1234

# Security / server
SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
RATE_LIMIT_ENABLED=true

# Rahu calculation
RAHU_DEFAULT_LOCATION=Colombo
RAHU_DEFAULT_LATITUDE=6.9271
RAHU_DEFAULT_LONGITUDE=79.8612
RAHU_TIMEZONE=Asia/Colombo
RAHU_DAILY_UPDATE_ENABLED=true
